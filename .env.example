# Developer fallback config for a repo checkout. Copy to `.env`.
#
# The app doesn't need this: people choose their AI in Komposit's settings
# (stored in Komposit's data folder). This file is read only when no AI has
# been chosen there.

# Which AI runs a turn when none is chosen in settings:
#   anthropic  the Anthropic API with ANTHROPIC_API_KEY
#   cli        your local Claude Code (`claude`), billed to your Claude plan
MODEL_PROVIDER=anthropic

# For MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
# Any Anthropic-compatible endpoint, e.g. the invite gateway in gateway/.
MODEL_BASE_URL=https://api.anthropic.com

# First port to try for the local server (4321-4330 are tried in turn).
PORT=4321

# Most tool calls the agent may make in one turn before it is stopped.
MAX_TOOL_CALLS=40

# Longest side, in pixels, of the renders the agent looks at. Smaller means
# fewer image tokens.
RENDER_MAX_PX=1024

# Where exported copies are written (your source files are never overwritten).
EXPORT_DIR=~/Komposit Exports
